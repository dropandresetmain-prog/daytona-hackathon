# With no credentials, text uses local keyword matching over the selected data.
# The supplied 40-profile synthetic CSV is the default dataset.
# Set BOTH switches for offline tests even when credentials are present:
# NETWORKING_MODE=mock
# NETWORKING_EXECUTION=local

# Attendee source is separate from LLM execution. Force mock for offline fixture tests.
# ATTENDEE_DATA_SOURCE=mock
# Auto-detect data/attendees.csv, or explicitly configure a server-only CSV path.
# A configured missing/invalid CSV fails instead of falling back to fictional profiles.
# ATTENDEE_DATA_SOURCE=csv
# ATTENDEES_CSV_PATH=data/attendees.csv
# Default event ID when the CSV has no eventId column; also selects the event shown by the UI.
# ATTENDEES_EVENT_ID=demo-event
# ATTENDEES_EVENT_NAME=SWITCH

# Qwen text inference. LLM_API_KEY is also supported as a key alias.
ALIBABA_CLOUD_API_KEY=
LLM_MODEL=qwen3.8-flash
ALIBABA_REGION=ap-southeast-1
# Optional voice workspace host; does not change the text inference endpoint.
ALIBABA_WORKSPACE_ID=
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime

# When set, recommendation inference runs inside a temporary Daytona sandbox.
DAYTONA_API_KEY=
DAYTONA_TARGET=

# Optional override for the single-process demo meeting inbox.
# MEETING_REQUESTS_FILE=.data/meeting-requests.json

# Unused optional graph placeholders. Neo4j is not required for this demo.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
